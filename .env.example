# SmartBank Environment Configuration Example
# Copy this file to .env and adjust variables as per your local setup

SECRET_KEY=smartbank-super-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3307
DB_NAME=smartbank_db

# Direct Database URL format:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3307/smartbank_db
# For SQLite testing/fallback:
# DATABASE_URL=sqlite:///smartbank.db
